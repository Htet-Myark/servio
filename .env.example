# Copy this file to .env and fill it in. .env is gitignored: never commit it.
# Supabase: project page > Connect > Session pooler. Replace [YOUR-PASSWORD];
# if the password contains @ : / ? # or %, URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Optional: run the tests against a different database (they always use schema servio_test).
# TEST_DATABASE_URL=
